    // INSTANCIA DE CORRELATIVAS
    const objetos2Correlativas = #{objetos1Aprobada, matematica1Aprobada}
    const objetos3Correlativas = #{objetos2Aprobada, basesDeDatosAprobada}
    // INSTANCIA DE MATERIAS APROBADAS
